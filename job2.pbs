#!/bin/bash

# =========================================================
# PBS JOB CONFIGURATION
# =========================================================

#PBS -N NYS_PySAM_Optimization_2Nodes
#PBS -q medium
#PBS -l select=2:ncpus=112:mpiprocs=1
#PBS -l place=scatter
#PBS -j oe
#PBS -M 23b0343@iitb.ac.in
#PBS -m abe


# =========================================================
# WORKING DIRECTORY
# =========================================================

cd "$PBS_O_WORKDIR" || exit 1

# =========================================================
# VALIDATE SEASON
# =========================================================

case "${SEASON:-}" in
    winter|summer|monsoon|post) ;;
    *)
        echo "ERROR: Set SEASON to winter, summer, monsoon, or post."
        exit 1
        ;;
esac

# =========================================================
# LOAD OPEN MPI
# =========================================================

source /apps/spack/v0.23/share/spack/setup-env.sh || exit 1
spack load openmpi@4.1.6 || exit 1

MPI_PREFIX="$(spack location -i openmpi@4.1.6)" || exit 1
export LD_LIBRARY_PATH="$MPI_PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# =========================================================
# PYTHON ENVIRONMENT USING UV
# =========================================================

if [ ! -x ".venv/bin/python" ]; then
    uv venv || exit 1
fi

uv sync || exit 1

# =========================================================
# DAGSHUB / MLFLOW AUTHENTICATION
# =========================================================

if [ -r "$HOME/.dagshub_token" ]; then
    export MLFLOW_TRACKING_USERNAME="aryanvj787"
    export MLFLOW_TRACKING_PASSWORD="$(cat "$HOME/.dagshub_token")"
    export MLFLOW_TRACKING_URI="https://dagshub.com/aryanvj787/NYS-Design-Optimisation-using-PySAM.mlflow"
else
    echo "WARNING: DagsHub token missing or unreadable."
    echo "Remote MLflow logging may fail."
fi

# =========================================================
# PARALLELISM SETTINGS
# =========================================================

export LOCAL_WORKERS="${LOCAL_WORKERS:-112}"
export APP_CPU_COUNT="${PBS_NCPUS:-224}"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

echo "================================================="
echo "NYS PySAM Seasonal Optimisation"
echo "Job ID       : ${PBS_JOBID:-unknown}"
echo "Season       : $SEASON"
echo "Working Dir  : $PWD"
echo "Total CPUs   : $APP_CPU_COUNT"
echo "MPI ranks    : 2"
echo "Local workers: $LOCAL_WORKERS"
echo "Start time   : $(date)"
echo "================================================="

# =========================================================
# RUN OPTIMISATION
# =========================================================

mpirun -np 2 \
    uv run python3 main.py --season "$SEASON"

EXIT_CODE=$?

echo "================================================="
echo "Season    : $SEASON"
echo "Exit code : $EXIT_CODE"
echo "End time  : $(date)"
echo "================================================="

exit "$EXIT_CODE"